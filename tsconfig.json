{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],

    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* Type checking — strict by default. Loosen deliberately, per project. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    /* The highest-value flag for agent-written code: `arr[0]` and `map[key]`
       become `T | undefined`, so the indexing that crashes at runtime fails at
       compile time instead. Non-null assertions are a lint error, so the fix
       has to be a real guard. */
    "noUncheckedIndexedAccess": true,
    /* `{ a?: string }` stops accepting an explicit `a: undefined`, which keeps
       "absent" and "present but undefined" from silently merging. */
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "scripts", "*.config.ts"]
}
