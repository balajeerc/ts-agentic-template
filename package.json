{
  "name": "ts-agentic-template",
  "version": "0.0.0",
  "license": "BSD-2-Clause",
  "author": "Balajee.R.C",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "check:format": "prettier --check .",
    "check:unused-code": "knip",
    "check:unused-prod-code": "knip --production --strict",
    "check:code-duplication": "jscpd src --min-lines 10 --threshold 0 --ignore \"**/__fixtures__/**\"",
    "check:dependency-rules": "depcruise src --config .dependency-cruiser.cjs",
    "check:vulnerabilities": "pnpm audit --audit-level=moderate",
    "scan:secrets": "./.tools/gitleaks git --redact --no-banner .",
    "check": "pnpm typecheck && pnpm check:format && pnpm lint && pnpm check:unused-code && pnpm check:unused-prod-code && pnpm check:code-duplication && pnpm check:dependency-rules && pnpm test:coverage",
    "fix": "eslint . --fix && prettier --write .",
    "hooks:install": "husky",
    "prepare": "husky",
    "tools:install": "bash scripts/installGitleaks.sh"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.1",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^17.3.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.16",
    "knip": "^5.82.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
