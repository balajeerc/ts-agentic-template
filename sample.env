# Copy to `.env` and fill in. `.env` is gitignored.
#
# Every variable here must also appear in the schema in `src/env.ts`. That file
# is what validates them at boot; this one is the human-readable reference.
# Add to both together.

# development | test | production
# NODE_ENV=development

# fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# EXAMPLE_API_KEY=
