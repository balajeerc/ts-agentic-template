# ===========================================
# pnpm Supply Chain Security Configuration
# See: https://pnpm.io/supply-chain-security
# ===========================================

# Prevent installing packages published within the last 30 days
# Protects against supply chain attacks where malicious packages are published briefly
minReleaseAge=30d

# Block transitive dependencies from using exotic sources (git repos, tarballs)
# Forces all dependencies to come from the npm registry
blockExoticSubdeps=true

# Prevent installation if package trust level decreases compared to previous releases
# Detects potential account takeovers or malicious updates
trustPolicy=no-downgrade

# Only allow specific packages to run postinstall/build scripts
# Configured in pnpm-workspace.yaml under allowBuilds
